# Copy to .env and fill in. .env is gitignored — never commit real values.

# Anthropic API key (alternatively: `ant auth login`, which the SDK picks up automatically)
ANTHROPIC_API_KEY=

# Google OAuth desktop-client secret and cached user token.
# Recommended: keep these OUTSIDE the repo entirely.
GOOGLE_CLIENT_SECRET_FILE=~/.config/digital-twin-ingest/client_secret.json
GOOGLE_TOKEN_FILE=~/.config/digital-twin-ingest/token.json

# Drive folder IDs (internal metadata — keep out of git).
# The folder ID is the last segment of the folder's URL in Drive.
INBOX_FOLDER_ID=
DIGITAL_TWIN_ROOT_FOLDER_ID=

# Path to the local (gitignored) config with the destination folders
INGEST_CONFIG=config.local.yaml
