# --- Environment / secrets -------------------------------------------
.env
.env.*
!.env.example
*.env
.envrc
secrets/
.secrets/

# --- Google OAuth / service account credentials ----------------------
credentials.json
credentials*.json
client_secret*.json
token.json
token*.json
*token*.json
*.pickle
service_account*.json
*-sa.json
*.p12
*.pem
*.key
*.crt
*.keystore

# --- Local config: personal taxonomy, folder IDs (MASKED) -------------
