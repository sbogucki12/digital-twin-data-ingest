config.yaml
config.yml
config.local.*
*.local.yaml
*.local.yml
*.local.json
!config.example.yaml

# --- Cost metrics / observability (spend data stays local) ------------
logs/
cost_metrics*
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
*.log

# --- Private, local-only materials (never published) -----------------
explainer_site/
# Migration manifests list personal file names/paths
archive_manifest*.csv
*_manifest.csv
*_manifest_results.csv

# --- Runtime state, caches, scratch output ---------------------------
state/
output/
out/
tmp/
.cache/

